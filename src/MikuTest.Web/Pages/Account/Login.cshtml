@page "/account/login"
@model MikuTest.Web.Pages.Account.LoginModel
@{ Layout = null; }
<!doctype html><html lang="zh-CN"><head><script src="/site-ui.js"></script><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>MikuTest · 登录</title><link rel="stylesheet" href="/app.css"><link rel="stylesheet" href="/phase2.css"><link rel="stylesheet" href="/design.css"></head>
<body><div class="shell"><header><a class="brand" href="/">MikuTest <span>ミクテスト</span></a><nav><a href="/">测试广场</a><a href="/practice">随机组卷</a><a href="/account/register">注册</a><button class="theme-toggle" type="button" data-theme-toggle title="依次切换：跟随系统、浅色、深色"><span>主题</span><span class="theme-mode" aria-live="polite"></span></button></nav></header><main>
<section class="account-card card"><div class="eyebrow">WELCOME BACK</div><h1>登录</h1><div asp-validation-summary="ModelOnly" class="form-error"></div>
<p class="muted">已有的邮箱形式账号，仍使用原登录名和密码。</p><form method="post"><input type="hidden" asp-for="ReturnUrl"><label>用户名<input asp-for="Input.UserName" autocomplete="username"></label><span asp-validation-for="Input.UserName" class="validation-message"></span>
<label>密码<input asp-for="Input.Password" autocomplete="current-password"></label><span asp-validation-for="Input.Password" class="validation-message"></span>
<label class="check"><input asp-for="Input.RememberMe"> 保持登录</label><button class="button" type="submit">登录</button></form><p>还没有账号？<a href="/account/register">注册一个</a></p></section>
</main><footer>MIKUTEST · KNOWLEDGE / SOUND / VISION · 非官方学习项目</footer></div></body></html>
