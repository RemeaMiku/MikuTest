@page "/account/change-password"
@model MikuTest.Web.Pages.Account.ChangePasswordModel
@{ Layout = null; }
<!doctype html><html lang="zh-CN"><head><script src="/site-ui.js"></script><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>MikuTest · 修改密码</title><link rel="stylesheet" href="/app.css"><link rel="stylesheet" href="/phase2.css"><link rel="stylesheet" href="/design.css"></head>
<body><div class="shell"><header><a class="brand" href="/">MikuTest <span>ミクテスト</span></a><nav aria-label="主导航"><a href="/">测试广场</a><a href="/practice">随机组卷</a><a href="/me">我的主页</a><button class="theme-toggle" type="button" data-theme-toggle title="依次切换：跟随系统、浅色、深色"><span>主题</span><span class="theme-mode" aria-live="polite"></span></button></nav></header><main>
<section class="account-card card"><div class="eyebrow">ACCOUNT SECURITY</div><h1>修改密码</h1>
@if(Model.SuccessMessage is not null){<p class="admin-success" role="status">@Model.SuccessMessage</p>}
<div asp-validation-summary="ModelOnly" class="form-error"></div>
<form method="post"><label>当前密码<input asp-for="Input.CurrentPassword" autocomplete="current-password"></label><span asp-validation-for="Input.CurrentPassword" class="validation-message"></span>
<label>新密码<input asp-for="Input.NewPassword" autocomplete="new-password"></label><span asp-validation-for="Input.NewPassword" class="validation-message"></span>
<label>确认新密码<input asp-for="Input.ConfirmPassword" autocomplete="new-password"></label><span asp-validation-for="Input.ConfirmPassword" class="validation-message"></span>
<div class="form-actions"><button class="button" type="submit">保存新密码</button><a class="secondary" href="/me">取消并返回</a></div></form></section>
</main><footer>MIKUTEST · KNOWLEDGE / SOUND / VISION · 非官方学习项目</footer></div></body></html>
