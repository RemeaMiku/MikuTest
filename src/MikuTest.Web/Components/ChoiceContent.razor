<span class="choice-content">
 @if(!string.IsNullOrEmpty(Text)){<span class="multiline">@Text</span>}
 @if(!string.IsNullOrEmpty(ImageUrl)){<img class="option-image" src="@ImageUrl" alt="@(string.IsNullOrWhiteSpace(Text)?"选项图片":Text)" loading="lazy" />}
</span>

@code {
    [Parameter]
    public string Text { get; set; } = "";

    [Parameter]
    public string? ImageUrl { get; set; }
}
