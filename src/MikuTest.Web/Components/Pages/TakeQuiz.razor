@page "/quiz/{Id:int}"
@rendermode InteractiveServer
@inject MikuTest.Web.Services.QuizService Service
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject AuthenticationStateProvider Auth
<ActionFeedback  Error="@error" />
<PageTitle>MikuTest · 答题</PageTitle>
@if(loading) { <p role="status">正在加载…</p> }
else if(quiz is null) { <h1>测试不存在</h1><a class="secondary" href="/">返回测试广场</a> }
else {
 <div class="eyebrow">QUIZ / @quiz.Questions.Count QUESTIONS</div><h1>@quiz.Title</h1><p>每题单选，总分 @quiz.TotalPoints.ToString("0.##") 分。未作答计 0 分。已选 @selections.Count / @quiz.Questions.Count 题。</p>
 <div class="progress-track" role="progressbar" aria-label="答题进度" aria-valuemin="0" aria-valuemax="@quiz.Questions.Count" aria-valuenow="@selections.Count"><span style="width:@(quiz.Questions.Count == 0 ? 0 : selections.Count * 100 / quiz.Questions.Count)%"></span></div>
 <div class="answer-layout"><AnswerNavigator Questions="quiz.Questions" Selections="selections" OnSubmit="RequestSubmit" Submitting="@(submitting || confirming)" /><div class="answer-content">
 @foreach(var block in QuestionBlocks.Split(quiz.Questions.OrderBy(x=>x.Order))) {
 <div class="answer-block"><SharedMaterial Group="block[0].Group" />
 @foreach(var question in block) {
  <section class="card question" id="@($"question-{question.Id}")" tabindex="-1" @key="question.Id">
   <QuestionContent Question="question" /><p class="question-points">本题 @question.Points.ToString("0.##") 分</p>
   <fieldset disabled="@(submitting || confirming)"><legend class="visually-hidden">第 @question.Order 题选项</legend>
   @foreach(var choice in question.Choices.OrderBy(x=>x.Id)) {
    <label class="choice"><input type="radio" name="@($"q-{question.Id}")" value="@choice.Id" checked="@(selections.GetValueOrDefault(question.Id)==choice.Id)" @onchange="()=>Select(question.Id,choice.Id)" /> <ChoiceContent Text="@choice.Text" ImageUrl="@choice.ImageUrl" /></label>
   }</fieldset>
  </section>
 }
 </div>}

 <div class="submit-bar"><p class="muted">离开或刷新答题页会丢失尚未提交的选择。</p><button class="button" disabled="@(submitting || confirming || quiz.Questions.Count==0)" @onclick="RequestSubmit">@(submitting ? "正在提交…" : "提交并查看结果 →")</button></div>
 </div></div>
}

@code {
    [Parameter]
    public int Id { get; set; }
    private MikuTest.Web.Models.Quiz? quiz;
    private readonly Dictionary<int, int> selections = [];
    private bool loading = true,
        submitting;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        selections.Clear();
        error = null;
        quiz = await Service.GetAsync(Id);
        loading = false;
    }

    private void Select(int questionId, int choiceId) => selections[questionId] = choiceId;

    private bool confirming;

    private async Task RequestSubmit()
    {
        if (submitting || confirming)
            return;
        confirming = true;
        try
        {
            var unanswered = quiz!.Questions.Count(q => !selections.ContainsKey(q.Id));
            if (
                unanswered > 0
                && !await JS.InvokeAsync<bool>(
                    "confirm",
                    $"还有 {unanswered} 道题未作答，未作答题将计 0 分。确定提交吗？"
                )
            )
                return;
            await Submit();
        }
        finally
        {
            confirming = false;
        }
    }

    private async Task Submit()
    {
        if (submitting)
            return;
        submitting = true;
        error = null;
        try
        {
            var userId = (await Auth.GetAuthenticationStateAsync()).User.FindFirstValue(
                ClaimTypes.NameIdentifier
            );
            var id = await Service.SubmitAsync(Id, selections, userId);
            Navigation.NavigateTo($"/results/{id}");
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
        catch
        {
            error = "提交失败，请重试。";
        }
        finally
        {
            submitting = false;
        }
    }
}
